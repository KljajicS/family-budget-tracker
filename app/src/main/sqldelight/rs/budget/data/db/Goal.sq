CREATE TABLE goal (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    target TEXT NOT NULL,
    monthly TEXT NOT NULL,
    currency TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0,
    position INTEGER
);

-- New goals append as the lowest priority; see Account.sq for rows without a position.
insertIgnore:
INSERT OR IGNORE INTO goal(id, name, target, monthly, currency, position)
VALUES (?, ?, ?, ?, ?, (SELECT COALESCE(MAX(position) + 1, 0) FROM goal));

update:
UPDATE goal SET name = ?, target = ?, monthly = ?, currency = ? WHERE id = ?;

archive:
UPDATE goal SET archived = 1 WHERE id = ?;

setPosition:
UPDATE goal SET position = ? WHERE id = ?;

active:
SELECT * FROM goal WHERE archived = 0 ORDER BY position IS NULL, position, name, id;

all:
SELECT * FROM goal ORDER BY position IS NULL, position, name, id;

byId:
SELECT * FROM goal WHERE id = ?;

deleteAll:
DELETE FROM goal;
