CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    currency TEXT NOT NULL,
    kind TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0
);

insertIgnore:
INSERT OR IGNORE INTO account(id, name, currency, kind, archived) VALUES (?, ?, ?, ?, ?);

update:
UPDATE account SET name = ?, currency = ?, kind = ?, archived = ? WHERE id = ?;

archive:
UPDATE account SET archived = 1 WHERE id = ?;

active:
SELECT * FROM account WHERE archived = 0 ORDER BY name;

byId:
SELECT * FROM account WHERE id = ?;

deleteAll:
DELETE FROM account;
