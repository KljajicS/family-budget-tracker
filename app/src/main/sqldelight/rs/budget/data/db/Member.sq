CREATE TABLE member (
    id TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    device_id TEXT NOT NULL
);

insertIgnore:
INSERT OR IGNORE INTO member(id, display_name, device_id) VALUES (?, ?, ?);

all:
SELECT * FROM member ORDER BY display_name;

rename:
UPDATE member SET display_name = ? WHERE id = ?;

byDevice:
SELECT * FROM member WHERE device_id = ?;

deleteAll:
DELETE FROM member;
