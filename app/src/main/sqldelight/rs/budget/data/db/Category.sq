CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    color TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0
);

insertIgnore:
INSERT OR IGNORE INTO category(id, name, color, archived) VALUES (?, ?, ?, ?);

update:
UPDATE category SET name = ?, color = ? WHERE id = ?;

active:
SELECT * FROM category WHERE archived = 0 ORDER BY name;

archive:
UPDATE category SET archived = 1 WHERE id = ?;

deleteAll:
DELETE FROM category;
