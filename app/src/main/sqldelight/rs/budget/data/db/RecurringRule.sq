CREATE TABLE recurring_rule (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    amount TEXT NOT NULL,
    currency TEXT NOT NULL,
    account_id TEXT NOT NULL,
    category_id TEXT NOT NULL,
    cadence TEXT NOT NULL,
    first_due TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0
);

upsert:
INSERT OR REPLACE INTO recurring_rule(id, name, amount, currency, account_id, category_id, cadence, first_due, archived)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

archive:
UPDATE recurring_rule SET archived = 1 WHERE id = ?;

active:
SELECT * FROM recurring_rule WHERE archived = 0 ORDER BY name;

byId:
SELECT * FROM recurring_rule WHERE id = ?;

deleteAll:
DELETE FROM recurring_rule;
