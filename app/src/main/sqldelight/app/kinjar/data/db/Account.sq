CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    currency TEXT NOT NULL,
    kind TEXT NOT NULL,
    archived INTEGER NOT NULL DEFAULT 0,
    position INTEGER
);

-- New accounts append to the saved order; rows without a position (older rows, or created while another device
-- reordered) sort after positioned ones by name.
insertIgnore:
INSERT OR IGNORE INTO account(id, name, currency, kind, archived, position)
VALUES (?, ?, ?, ?, ?, (SELECT COALESCE(MAX(position) + 1, 0) FROM account));

update:
UPDATE account SET name = ?, currency = ?, kind = ? WHERE id = ?;

archive:
UPDATE account SET archived = 1 WHERE id = ?;

setPosition:
UPDATE account SET position = ? WHERE id = ?;

active:
SELECT * FROM account WHERE archived = 0 ORDER BY position IS NULL, position, name, id;

all:
SELECT * FROM account ORDER BY position IS NULL, position, name, id;

byId:
SELECT * FROM account WHERE id = ?;

-- Same rule as BudgetRepository's local currency guard, so replay decides exactly as the writing phone did.
inUse:
SELECT (SELECT COUNT(*) FROM tx WHERE tx.account_id = :id OR tx.to_account_id = :id)
    + (SELECT COUNT(*) FROM recurring_rule WHERE recurring_rule.archived = 0 AND recurring_rule.account_id = :id);

deleteAll:
DELETE FROM account;
